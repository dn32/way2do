{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Auth": {
    "AllowedOrigins": [],
    "SecureCookie": true,
    "LoginRateLimit": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    }
  },
  "Network": {
    "TrustedProxies": []
  }
}
