# Copie para .env e preencha. O .env não é versionado: nenhuma credencial fica no repositório.

# Obrigatório: senha do Postgres (qualquer valor).
POSTGRES_PASSWORD=

# Obrigatório: senhas dos usuários de teste, criados na primeira subida da API.
# Use as senhas enviadas por e-mail ou defina as suas.
Seed__Users__Ana__Password=
Seed__Users__Bruno__Password=

# Opcional no ambiente local (se vazio, a API gera uma chave aleatória a cada subida e as sessões caem ao
# reiniciar). Obrigatório em produção: no mínimo 32 caracteres aleatórios.
Jwt__SigningKey=

# ---------------------------------------------------------------------------------------------------------------
# Só na VPS (docker compose -f docker-compose.yml -f docker-compose.vps.yml up -d --build). No local, deixe vazio.
# Hostnames públicos do túnel da Cloudflare (sem https://) e o token do túnel (painel da Cloudflare > Tunnels).
# Na VPS, Jwt__SigningKey acima é obrigatória.
WAY2DO_HOST=
CONSUMER_HOST=
CLOUDFLARE_TUNNEL_TOKEN=
